{
  "manifest_version": 3,
  "name": "Web Page Data Extractor",
  "version": "1.0",
  "description": "Extracts images, JS files, and tables from web pages.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
